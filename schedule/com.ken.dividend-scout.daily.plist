<?xml version="1.0" encoding="UTF-8"?>
<!-- 平日 07:30 に保有とウォッチリストを監視。
     インストール（ケンが自分で実行する）:
       cp schedule/com.ken.dividend-scout.daily.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.ken.dividend-scout.daily.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ken.dividend-scout.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ken/Desktop/クロード/dividend-scout/.venv/bin/python</string>
    <string>/Users/ken/Desktop/クロード/dividend-scout/scripts/daily_watch.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/ken/Desktop/クロード/dividend-scout</string>
  <key>EnvironmentVariables</key>
  <dict><key>NTFY_TOPIC</key><string>ここにトピック名を入れる</string></dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/ken/Desktop/クロード/dividend-scout/logs/daily.log</string>
  <key>StandardErrorPath</key><string>/Users/ken/Desktop/クロード/dividend-scout/logs/daily.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
