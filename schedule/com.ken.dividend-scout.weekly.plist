<?xml version="1.0" encoding="UTF-8"?>
<!-- 土曜 09:00 に全市場スキャン。
     インストール（ケンが自分で実行する）:
       cp schedule/com.ken.dividend-scout.weekly.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.ken.dividend-scout.weekly.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ken.dividend-scout.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ken/Desktop/クロード/dividend-scout/.venv/bin/python</string>
    <string>/Users/ken/Desktop/クロード/dividend-scout/scripts/weekly_scan.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/ken/Desktop/クロード/dividend-scout</string>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/ken/Desktop/クロード/dividend-scout/logs/weekly.log</string>
  <key>StandardErrorPath</key><string>/Users/ken/Desktop/クロード/dividend-scout/logs/weekly.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
